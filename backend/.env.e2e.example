# Isolated environment for the Playwright end-to-end tests (frontend/e2e). It is loaded only when
# APP_ENV=e2e, so it can never touch your normal database. e2e/support/prepare.mjs copies this to
# `.env.e2e`, fills in APP_KEY and the absolute DB_DATABASE path, and runs migrate:fresh.
APP_NAME="ClientHub E2E"
APP_ENV=e2e
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8100
APP_TIMEZONE=UTC
BCRYPT_ROUNDS=4

LOG_CHANNEL=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Mail goes to storage/logs/laravel.log; the setup reads the password links from there.
MAIL_MAILER=log
FRONTEND_URL=http://localhost:5273